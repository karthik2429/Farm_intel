# =============================================================================
# FarmIntel / AgroSmart AI — BACKEND environment
# Copy to Farm_intel/.env (same folder). Never commit .env.
# Everything here is FREE tier. Every value is optional: the API boots with
# nothing set and each keyed feature reports an honest "not configured" state.
# =============================================================================

# ----------------------------------------------------------------- runtime ---
# required: which port the FastAPI server binds (start.sh and serve.py read it)
BACKEND_PORT=8000
# optional: comma-separated allowed origins. "*" is fine for local dev.
CORS_ORIGINS=*
# optional: development | production (production hides /config/status details)
APP_ENV=development

# ------------------------------------------------------- mandi price pipeline
# required for LIVE mandi prices. Free key: https://data.gov.in/user/register
# (resource: "Current Daily Price of Various Commodities from Various Markets")
DATA_GOV_API_KEY=
# optional: AGMARKNET daily-snapshot resource id (defaults to the official one)
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# optional: SQLite price store location (default backend/mandi_price_store.db)
MANDI_DB_PATH=mandi_price_store.db
# optional: minutes a cached mandi answer stays fresh before a live re-probe
MANDI_CACHE_TTL_MINUTES=180

# --------------------------------------------------------------- supabase ----
# optional (auth + profile + chat history). Free: https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-side only, used by the daily ingest job to mirror prices. NEVER ship it.
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------ chat LLM -------
# Free tier: https://aistudio.google.com/apikey  (recommended, best quality)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free tier: https://openrouter.ai/keys (pick a ":free" model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# optional local fallback: https://ollama.com (run `ollama serve`)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# ------------------------------------------------------- chat cost control ---
CHAT_MAX_OUTPUT_TOKENS=700
CHAT_MAX_HISTORY_MESSAGES=6
CHAT_RATE_LIMIT_PER_USER_PER_HOUR=40
CHAT_CACHE_TTL_HOURS=6

# --------------------------------------------------------------- voice -------
# browser | bhashini | sarvam  (browser needs no keys at all)
SPEECH_PROVIDER=browser
# Free: https://bhashini.gov.in (ULCA) — Indian language ASR/TTS
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
# Free tier: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ------------------------------------------------- external data sources -----
# All free, no key needed. Overridable for self-hosting/mirrors.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Nominatim usage policy requires a real contact UA: https://nominatim.org
NOMINATIM_USER_AGENT=farmintel/3.0 (contact: you@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# optional satellite/soil integrations (leave blank: features hide themselves)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# optional crop photography (leave blank: crop tiles use a leaf glyph)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --------------------------------------------------------- chat link guard ---
# only these hosts may ever be opened by the assistant's open_external tool
OPEN_EXTERNAL_ALLOWLIST=agmarknet.gov.in,enam.gov.in,pmkisan.gov.in,soilhealth.dac.gov.in,mausam.imd.gov.in,myscheme.gov.in,kisan.gov.in
