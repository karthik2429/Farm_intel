# FarmIntel environment (copy to .env and fill in)
#
# Frontend
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend data pipeline
# api.data.gov.in key — used server-side only (mandi ingest + live probe)
# Get your own key: https://data.gov.in ("Current Daily Price of Various
# Commodities from Various Markets (Mandi)" resource).
DATA_GOV_API_KEY=<your-data-gov-in-key>

# Optional: shared mandi history mirror for the daily CI ingest
# (.github/workflows/daily-mandi-ingest.yml)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key — server-side/ACTIONS ONLY, never in the app>
