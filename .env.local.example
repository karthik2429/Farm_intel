# =============================================================================
# FarmIntel / FarmIntel — FRONTEND environment
# Copy to Farm_intel/.env.local. Every VITE_ value is PUBLIC (it ships in the
# JS bundle) — never put a secret key in this file.
# =============================================================================

# required: where the FastAPI backend runs (must match BACKEND_PORT)
VITE_API_BASE_URL=http://127.0.0.1:8000

# optional (auth). Project settings > API in https://supabase.com — these two
# values are public by design; the service-role key must never appear here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# optional auth toggles (both default on)
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_EMAIL_OTP=true

# optional: browser | bhashini | sarvam (browser = Web Speech API, no keys)
VITE_SPEECH_PROVIDER=browser
# optional: en | hi | kn | te | ta | ml | mr | gu | bn | pa | or
VITE_DEFAULT_LANGUAGE=en

# optional: free reverse geocoding, no key required
VITE_REVERSE_GEOCODE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
# optional: raster map tiles for the location picker
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
